{
  "name": "ultimate-esports-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ultimate Esports Manager - a deep, spreadsheet-style esports management simulation (MOBA & Shooters).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:portable": "tsc --noEmit -p . && vite build --mode portable",
    "check:portable": "npm run build:portable && node scripts/portable-check.cjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:long": "LONG_SIM=1 vitest run tests/longterm.test.ts",
    "e2e": "playwright test --trace off",
    "sim:bench": "vitest run tests/bench.test.ts"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.4"
  }
}
